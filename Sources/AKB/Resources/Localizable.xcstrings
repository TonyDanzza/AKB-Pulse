    "error.toolNotFound.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "libimobiledevice required"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен libimobiledevice"
          }
        }
      }
    },
    "error.toolNotFound.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AKB reads the battery level with ideviceinfo. Install it with Homebrew:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение читает заряд утилитой ideviceinfo. Установи её через Homebrew:"
          }
        }
      }
    },
    "error.noDevice.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone not found"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не найден"
          }
        }
      }
    },
    "error.noDevice.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Connect the iPhone with a cable.\n2. Finder → iPhone → General → turn on “Show this iPhone when on Wi‑Fi”.\n3. Tap “Trust” on the iPhone.\n4. Unplug the cable — the Mac and the iPhone must share one Wi‑Fi network."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Подключи iPhone кабелем.\n2. Finder → iPhone → Основные → включи «Показывать этот iPhone, если он подключён к Wi‑Fi».\n3. Нажми «Доверять» на телефоне.\n4. Отключи кабель — Mac и iPhone должны быть в одной сети Wi‑Fi."
          }
        }
      }
    },
    "error.deviceUnreachable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone unreachable"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone вне сети"
          }
        }
      }
    },
    "error.deviceUnreachable.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone is not responding. Make sure it is on, unlocked and on the same Wi‑Fi network as the Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не отвечает. Проверь, что он включён, разблокирован и в той же сети Wi‑Fi, что и Mac."
          }
        }
      }
    },
    "error.parseFailure.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unexpected reply"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непонятный ответ телефона"
          }
        }
      }
    },
    "error.parseFailure.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ideviceinfo returned data that could not be parsed. Please try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ideviceinfo вернул данные, которые не удалось разобрать. Попробуй ещё раз."
          }
        }
      }
    },
    "error.timeout.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone did not answer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не ответил"
          }
        }
      }
    },
    "error.timeout.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer within 10 seconds. Usually that means the iPhone is asleep or off the network."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не ответил за 10 секунд. Обычно это значит, что он спит или вне сети."
          }
        }
      }
    },
    "notification.low.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone battery is low"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
