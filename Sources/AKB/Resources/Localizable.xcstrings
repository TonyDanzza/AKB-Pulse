    "onboarding.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to AKB"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в «АКБ»"
          }
        }
      }
    },
    "onboarding.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four steps and your iPhone battery lands in the menu bar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре шага — и заряд iPhone будет в строке меню."
          }
        }
      }
    },
    "onboarding.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the iPhone to the Mac with a cable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключи iPhone к Mac кабелем."
          }
        }
      }
    },
    "onboarding.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Finder pick the iPhone → “General” tab → turn on “Show this iPhone when on Wi‑Fi”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Finder выбери iPhone → вкладка «Основные» → включи «Показывать этот iPhone, если он подключён к Wi‑Fi»."
          }
        }
      }
    },
    "onboarding.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Trust” on the iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone нажми «Доверять»."
          }
        }
      }
    },
    "onboarding.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unplug the cable. The Mac and the iPhone must share one Wi‑Fi network."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключи кабель. Mac и iPhone должны быть в одной сети Wi‑Fi."
          }
        }
      }
    },
    "onboarding.openFinder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
