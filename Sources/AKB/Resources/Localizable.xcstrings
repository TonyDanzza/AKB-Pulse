    "empty.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить снова"
          }
        }
      }
    },
    "error.deviceUnreachable.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone is not responding. Make sure it is on, unlocked and on the same Wi‑Fi network as the Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не отвечает. Проверь, что он включён, разблокирован и в той же сети Wi‑Fi, что и Mac."
          }
        }
      }
    },
    "error.deviceUnreachable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone unreachable"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone вне сети"
          }
        }
      }
    },
    "error.noDevice.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the iPhone with a cable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключи iPhone кабелем."
          }
        }
      }
    },
    "error.noDevice.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder → iPhone → General → turn on “Show this iPhone when on Wi‑Fi”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder → iPhone → Основные → включи «Показывать этот iPhone, если он подключён к Wi‑Fi»."
          }
        }
      }
    },
    "error.noDevice.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Trust” on the iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми «Доверять» на телефоне."
          }
        }
      }
    },
    "error.noDevice.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unplug the cable — the Mac and the iPhone must share one Wi‑Fi network."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключи кабель — Mac и iPhone должны быть в одной сети Wi‑Fi."
          }
        }
      }
    },
    "error.noDevice.step5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a VPN is on, on the Mac or on the iPhone, allow local network access in it or turn it off while searching."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если на Mac или iPhone включён VPN — разреши в нём доступ к локальной сети или выключи его на время поиска."
          }
        }
      }
    },
    "error.noDevice.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone not found"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не найден"
          }
        }
      }
    },
    "error.parseFailure.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ideviceinfo returned data that could not be parsed. Please try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ideviceinfo вернул данные, которые не удалось разобрать. Попробуй ещё раз."
          }
        }
      }
    },
    "error.parseFailure.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unexpected reply"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непонятный ответ телефона"
          }
        }
      }
    },
    "error.timeout.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer within 10 seconds. Usually that means the iPhone is asleep or off the network."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не ответил за 10 секунд. Обычно это значит, что он спит или вне сети."
          }
        }
      }
    },
    "error.timeout.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone did not answer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон не ответил"
          }
        }
      }
    },
    "error.toolNotFound.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AKB reads the battery level with ideviceinfo. Install it with Homebrew:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение читает заряд утилитой ideviceinfo. Установи её через Homebrew:"
          }
        }
      }
    },
    "error.toolNotFound.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "libimobiledevice required"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен libimobiledevice"
          }
        }
      }
    },
    "hint.localNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow local network access in System Settings → Privacy & Security"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши доступ к локальной сети в Системных настройках → Конфиденциальность"
